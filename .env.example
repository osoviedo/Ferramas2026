SECRET_KEY=cambia-esta-clave

# Mercado Pago — reemplaza con tus credenciales de prueba (sandbox) desde
# https://www.mercadopago.cl/developers/panel/app
# El valor TEST-123456789-abcdef activa modo simulado (no abre Mercado Pago).
MP_ACCESS_TOKEN=APP_USR-tu-access-token-sandbox
MP_PUBLIC_KEY=APP_USR-tu-public-key-sandbox

DATABASE_URL=sqlite:///ferramas.db
DIVISA_CACHE_SEGUNDOS=3600

# URL pública de la app (necesaria para callbacks de Mercado Pago).
# En local, 127.0.0.1 provoca error al volver desde MP; usa ngrok:
#   ngrok http 5000  →  PUBLIC_BASE_URL=https://xxxx.ngrok-free.app
PUBLIC_BASE_URL=http://127.0.0.1:5000

# API Banco Central (BDE) - opcional, para conversión de divisas
BCENTRAL_USER=
BCENTRAL_PASS=

# Demo local: auto-login Ferramas + cuenta comprador MP sandbox
DEV_AUTO_LOGIN=false
DEV_LOGIN_EMAIL=cliente@ferramas.cl
DEV_LOGIN_PASSWORD=cliente123
MP_TEST_BUYER_USER=
MP_TEST_BUYER_PASSWORD=